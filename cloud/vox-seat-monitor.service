[Unit]
Description=VOX Seat Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vox-seat-monitor
ExecStart=/usr/bin/node /opt/vox-seat-monitor/monitor.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
