# Copy this file to .env, then fill in your Telegram values.

# BotFather gives you this after /newbot
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Your Telegram chat ID. Message the bot first, then run .\test-telegram.ps1.
TELEGRAM_CHAT_ID=replace_me

# Rolling future scan window. This moves forward every day.
VOX_LOOKAHEAD_DAYS=21

# Optional fixed end date. Format: YYYYMMDD. Leave unset for always-on monitoring.
# VOX_END_DATE=20260820

# Check interval. Cycles are scheduled from the start of the previous check.
VOX_POLL_MINUTES=5

# Speed settings. Date scans use lightweight parallel HTTP; seat maps still use live booking pages.
VOX_PARALLEL_DATE_SCANS=6
VOX_HTTP_TIMEOUT_MS=10000
# Optional retry knobs, useful on cloud runners if VOX is slow from that network.
VOX_HTTP_RETRIES=0
VOX_HTTP_RETRY_DELAY_MS=1000
VOX_ABORT_SCAN_ON_FIRST_DATE_FAILURE=0
VOX_SHOWTIME_FETCH_MODE=http
VOX_SHOWTIME_BROWSER_FETCH_TIMEOUT_MS=15000
VOX_PAGE_WAIT_MS=10000
VOX_BOOKING_WAIT_MS=20000
VOX_BLOCK_ASSETS=1
VOX_SKIP_UNAVAILABLE_LISTINGS=0
VOX_TELEGRAM_COMMANDS=1
VOX_TELEGRAM_COMMAND_TIMEOUT_SECONDS=25
VOX_TELEGRAM_IGNORE_OLD_UPDATES_ON_START=1
VOX_MEASURE_NETWORK=1
VOX_NETWORK_LOG_EVERY_SECONDS=60

# Local low-internet mode: listen for Telegram commands only; no automatic VOX scans.
VOX_COMMAND_ONLY=1

# Optional lightweight auto-watch for newly released days.
# Toggle it from Telegram with /newdays on or /newdays off.
# It scans showtime/date pages only and does not open seat maps.
VOX_NEW_DAY_WATCH_ENABLED=0
VOX_NEW_DAY_WATCH_INTERVAL_MINUTES=15

# Target
VOX_CITY=city-centre-almaza
VOX_MOVIE=the-odyssey
VOX_EXPERIENCE=IMAX
VOX_EXPERIENCES=IMAX,Standard

# Target seats are experience-specific because IMAX and Standard seat maps differ.
VOX_TARGET_SEATS_IMAX=E,F,G,H,J,K,L:18-7
VOX_TARGET_SEATS_STANDARD=B,C,D:8-1

# Legacy broad watch-range alerts are off. Keep this off unless you want the old extra messages.
VOX_LEGACY_INTERESTED_ALERTS=0

# Optional: 1 sends a summary every check. 0 sends only alerts/first baseline.
VOX_SEND_EVERY_CHECK=0

# Command-only local default:
# release = auto-check seats only when a new date/showtime/link/bookable event appears.
# all = old behavior, checks every known seat map every cycle.
# none = never auto-check seats; use Telegram /check commands only.
VOX_AUTO_SEAT_CHECK_MODE=none
VOX_FULL_SEAT_CHECK_EVERY_MINUTES=0

# Useful for scheduled GitHub Actions state commits; normal local runs can omit these.
# VOX_PERSIST_LAST_RUN=0
# VOX_PERSIST_SEEN_TIMESTAMPS=0
# VOX_FORCE_EXIT_AFTER_ONCE=0
